# =====================================================================
# AI Pocket Tutor — environment variables
# Copy this file to `.env.local` and fill in real values for development.
# NEVER commit .env.local. The .env.example file is the only one tracked.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCATION=ON-CA   # Ontario, Canada (default curriculum)

# --- Supabase (database, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-side ONLY — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Private storage bucket name for child uploads.
SUPABASE_UPLOADS_BUCKET=child-uploads

# --- Claude (Anthropic) ---
# Required to make real AI calls. Without this, lib/aiService.ts returns a
# deterministic stub so the UI still renders end-to-end in dev.
ANTHROPIC_API_KEY=
# Default model is claude-opus-4-7 (latest at MVP launch). Override for cost
# experiments — e.g. claude-sonnet-4-6, claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-4-7

# --- Stripe (payments — placeholder structure for MVP) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SINGLE_CHILD=
STRIPE_PRICE_FAMILY=

# --- Privacy / safety ---
# When true, uploaded files are deleted from storage as soon as analysis completes.
DELETE_UPLOADS_AFTER_PROCESSING=true
# Maximum upload size in MB (server enforced).
MAX_UPLOAD_MB=10
